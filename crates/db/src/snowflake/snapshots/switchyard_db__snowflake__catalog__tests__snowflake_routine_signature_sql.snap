---
source: crates/db/src/snowflake/catalog.rs
expression: "format!(\"{}\\n{}\", routine_signature_sql(ObjectKind::Function),\nroutine_signature_sql(ObjectKind::Procedure))"
---
SELECT ARGUMENT_SIGNATURE FROM INFORMATION_SCHEMA.FUNCTIONS WHERE FUNCTION_SCHEMA = ? AND FUNCTION_NAME = ? ORDER BY ARGUMENT_SIGNATURE LIMIT 1
SELECT ARGUMENT_SIGNATURE FROM INFORMATION_SCHEMA.PROCEDURES WHERE PROCEDURE_SCHEMA = ? AND PROCEDURE_NAME = ? ORDER BY ARGUMENT_SIGNATURE LIMIT 1
