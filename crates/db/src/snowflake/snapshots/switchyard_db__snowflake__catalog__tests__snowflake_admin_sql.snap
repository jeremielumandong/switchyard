---
source: crates/db/src/snowflake/catalog.rs
expression: "[objects.join(\"\\n\"), tasks_sql(\"ETL \\\"x\\\"\"), show_like(\"ROLES\", \"o'brien\"),\nSTAGE_SQL.into(),].join(\"\\n\")"
---
Stage: SELECT STAGE_NAME AS TABLE_NAME, NULL AS ROW_COUNT, LOWER(STAGE_TYPE) || COALESCE(' · ' || STAGE_URL, '') AS COMMENT FROM INFORMATION_SCHEMA.STAGES WHERE STAGE_SCHEMA = ? ORDER BY STAGE_NAME
Pipe: SELECT PIPE_NAME AS TABLE_NAME, NULL AS ROW_COUNT, CASE WHEN IS_AUTOINGEST_ENABLED = 'YES' THEN 'auto-ingest' ELSE 'manual' END || COALESCE(' · ' || COMMENT, '') AS COMMENT FROM INFORMATION_SCHEMA.PIPES WHERE PIPE_SCHEMA = ? ORDER BY PIPE_NAME
SHOW TASKS IN SCHEMA "ETL ""x"""
SHOW ROLES LIKE 'o''brien'
SELECT STAGE_TYPE, STAGE_URL, STAGE_REGION, STORAGE_INTEGRATION, STAGE_OWNER, COMMENT, CREATED FROM INFORMATION_SCHEMA.STAGES WHERE STAGE_SCHEMA = ? AND STAGE_NAME = ?
