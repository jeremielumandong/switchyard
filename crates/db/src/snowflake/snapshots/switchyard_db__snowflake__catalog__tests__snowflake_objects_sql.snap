Table: SELECT TABLE_NAME, ROW_COUNT, COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_TYPE IN ('BASE TABLE', 'TEMPORARY TABLE', 'EXTERNAL TABLE') ORDER BY TABLE_NAME
