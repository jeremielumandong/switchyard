---
source: crates/db/src/snowflake/catalog.rs
expression: "search_sql(200, false)"
---
SELECT SCHEMA_NAME, OBJECT_NAME, KIND FROM ( SELECT TABLE_SCHEMA AS SCHEMA_NAME, TABLE_NAME AS OBJECT_NAME, CASE TABLE_TYPE WHEN 'VIEW' THEN 'view' WHEN 'MATERIALIZED VIEW' THEN 'mview' ELSE 'table' END AS KIND FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME ILIKE ? ESCAPE '!' AND TABLE_SCHEMA <> 'INFORMATION_SCHEMA' UNION ALL SELECT FUNCTION_SCHEMA, FUNCTION_NAME, 'function' FROM INFORMATION_SCHEMA.FUNCTIONS WHERE FUNCTION_NAME ILIKE ? ESCAPE '!' UNION ALL SELECT PROCEDURE_SCHEMA, PROCEDURE_NAME, 'procedure' FROM INFORMATION_SCHEMA.PROCEDURES WHERE PROCEDURE_NAME ILIKE ? ESCAPE '!' ) GROUP BY SCHEMA_NAME, OBJECT_NAME, KIND ORDER BY LENGTH(OBJECT_NAME), OBJECT_NAME, SCHEMA_NAME LIMIT 200
