---
source: crates/db/src/mssql/catalog.rs
expression: detail_indexes_sql(id)
---
SELECT i.name, i.is_unique, i.is_primary_key, i.type_desc, c.name, ic.is_descending_key FROM sys.indexes i JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id WHERE i.object_id = OBJECT_ID(N'[dbo].[t]') AND i.name IS NOT NULL AND ic.is_included_column = 0 ORDER BY i.name, ic.key_ordinal
