DROP TABLE sales."order";
DROP VIEW sales."order";
-- SQLite has no DROP MATERIALIZED VIEW
-- SQLite has no DROP FUNCTION
-- SQLite has no DROP PROCEDURE
-- SQLite has no DROP SEQUENCE
-- SQLite has no DROP TYPE
-- SQLite has no DROP SYNONYM
