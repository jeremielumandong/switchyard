---
source: crates/db/src/dialect/mod.rs
expression: "[d.select_page(&q, &names(&[\"id\", \"Order Date\"]),\nSome(\"total > 100 AND status = 'open'\"), &order, 500, 1000),\nd.select_page(&q, &[], None, &[], 100, 0),\nd.select_page(&q, &[], Some(\"  \"), &[SortKey::asc(\"id\")], 100,\n100),].join(\"\\n\\n\")"
---
SELECT id, `Order Date`
FROM sales.`order`
WHERE total > 100 AND status = 'open'
ORDER BY `Order Date` DESC, id ASC
LIMIT 500 OFFSET 1000

SELECT *
FROM sales.`order`
LIMIT 100 OFFSET 0

SELECT *
FROM sales.`order`
ORDER BY id ASC
LIMIT 100 OFFSET 100
