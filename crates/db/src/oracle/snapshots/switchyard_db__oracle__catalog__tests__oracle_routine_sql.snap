---
source: crates/db/src/oracle/catalog.rs
expression: "[ROUTINE_DDL_SQL, ROUTINE_SOURCE_SQL, ROUTINE_PARAMS_SQL].join(\"\\n\")"
---
SELECT DBMS_METADATA.GET_DDL(:1, :2, :3) FROM DUAL
SELECT TEXT FROM ALL_SOURCE WHERE OWNER = :1 AND NAME = :2 AND TYPE = :3 ORDER BY LINE
SELECT ARGUMENT_NAME, DATA_TYPE FROM ALL_ARGUMENTS WHERE OWNER = :1 AND OBJECT_NAME = :2 AND PACKAGE_NAME IS NULL AND DATA_LEVEL = 0 AND POSITION > 0 AND ARGUMENT_NAME IS NOT NULL AND IN_OUT IN ('IN', 'IN/OUT') ORDER BY POSITION
