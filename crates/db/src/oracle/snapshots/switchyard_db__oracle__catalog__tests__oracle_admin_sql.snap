---
source: crates/db/src/oracle/catalog.rs
expression: "[PACKAGES_SQL, USERS_SQL, USERS_SQL_PRE12C, ROLES_SQL_DBA, ROLES_SQL_GRANTED,\nUSER_SQL, PRINCIPAL_DDL_SQL,].join(\"\\n\")"
---
SELECT o.OBJECT_NAME, LOWER(o.STATUS) || CASE WHEN EXISTS ( SELECT 1 FROM ALL_OBJECTS b WHERE b.OWNER = o.OWNER AND b.OBJECT_NAME = o.OBJECT_NAME AND b.OBJECT_TYPE = 'PACKAGE BODY') THEN ' · spec + body' ELSE ' · spec only' END FROM ALL_OBJECTS o WHERE o.OWNER = :1 AND o.OBJECT_TYPE = 'PACKAGE' ORDER BY o.OBJECT_NAME
SELECT USERNAME, 'user · created ' || TO_CHAR(CREATED, 'YYYY-MM-DD') FROM ALL_USERS WHERE ORACLE_MAINTAINED = 'N' ORDER BY USERNAME
SELECT USERNAME, 'user · created ' || TO_CHAR(CREATED, 'YYYY-MM-DD') FROM ALL_USERS ORDER BY USERNAME
SELECT ROLE, 'role' FROM DBA_ROLES WHERE ORACLE_MAINTAINED = 'N' ORDER BY ROLE
SELECT GRANTED_ROLE, 'role · granted to you' FROM USER_ROLE_PRIVS ORDER BY 1
SELECT USERNAME, TO_CHAR(CREATED, 'YYYY-MM-DD HH24:MI:SS') FROM ALL_USERS WHERE USERNAME = :1
SELECT DBMS_METADATA.GET_DDL(:1, :2) FROM DUAL
