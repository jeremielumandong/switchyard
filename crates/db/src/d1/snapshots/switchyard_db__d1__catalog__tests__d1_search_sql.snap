---
source: crates/db/src/d1/catalog.rs
expression: search_sql(false)
---
SELECT m.name, m.type FROM sqlite_master m WHERE m.type IN ('table', 'view') AND m.name LIKE ?1 ESCAPE '!' AND m.name NOT LIKE 'sqlite\_%' ESCAPE '\' AND m.name NOT LIKE '\_cf\_%' ESCAPE '\' ORDER BY length(m.name), m.name LIMIT ?2
